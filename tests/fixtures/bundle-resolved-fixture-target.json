        "tasks": [
          {
            "environment_key": "default",
            "notebook_task": {
              "notebook_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/files/assignments/assignment-03/notebooks/assignment_03_streaming"
            },
            "task_key": "streaming"
