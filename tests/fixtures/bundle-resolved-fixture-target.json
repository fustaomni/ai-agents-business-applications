    "schemas": {
      "assignment_01": {
        "catalog_name": "cscie103_catalog",
        "comment": "This project's schema. Fully managed by the cscie103-data-engineering bundle. Objects created here by hand are drift.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "USE_SCHEMA",
              "SELECT"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "assignment_01"
      },
      "assignment_02": {
        "catalog_name": "cscie103_catalog",
        "comment": "Assignment 2 (TPC-H ETL). Fully managed by the cscie103-data-engineering bundle. Objects created here by hand are drift.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "USE_SCHEMA",
              "SELECT"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "assignment_02"
      },
      "assignment_03": {
        "catalog_name": "cscie103_catalog",
        "comment": "Assignment 3 (batch and streaming). Fully managed by the cscie103-data-engineering bundle. Objects created here by hand are drift.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "USE_SCHEMA",
              "SELECT"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
