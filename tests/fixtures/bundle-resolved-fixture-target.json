  "sync": {
    "paths": [
      "."
    ]
  },
  "variables": {
    "catalog": {
      "default": "cscie103_catalog",
      "description": "Unity Catalog catalog. NOT created by this bundle - prerequisite.",
      "value": "cscie103_catalog"
    },
    "environment_version": {
      "default": "5",
      "description": "Databricks serverless environment version. AUTHORITATIVE: this value determines the Python interpreter the server runs, and contracts/environment-versions.json maps it to the local .python-version. check:env-parity fails the build when the two disagree.",
      "value": "5"
    },
    "owner_email": {
      "default": "fixture-user@example.invalid",
      "description": "Where job failure notifications go. NOT the deployer: on_failure was the deploying user's address, which sends CI failures to the service principal -- an identity with no inbox. A notification nobody receives is worse than none, because it looks like coverage.\nNO DEFAULT, DELIBERATELY. An address here would be personal data committed to the repository, which the PII scanner correctly reports. Each target supplies its own: a placeholder for fixture capture, the real address via BUNDLE_VAR_owner_email when deploying.",
      "value": "fixture-user@example.invalid"
    },
    "reader_principal": {
      "default": "cscie103_readers",
      "description": "Account group granted read access to this bundle's UC objects. Provisioned by `mise run bootstrap:identity`, NOT by this bundle -- groups are not a bundle resource type, so a bundle can only reference them.\nMUST BE AN ACCOUNT GROUP. `users` and `admins` are WORKSPACE-LOCAL, and workspace-local groups cannot hold privileges on UC securables at all. The API reports that attempt as PRINCIPAL_DOES_NOT_EXIST, which reads like a missing group but is a category error, and it is a documented common cause of UC access failures.\nNOT `account users` either: that exists and would work, but it means every account user. UC best practice is least privilege via purpose-named groups.\nNOT a user identity: owners already hold all privileges, so a self-grant is redundant, and UC best practice is to avoid direct grants to users.",
      "value": "cscie103_readers"
    },
    "schema": {
      "default": "assignment_01",
      "description": "Bare schema name. The RESOURCE keeps this plain value. Never interpolate schema_prefix into resources.schemas.*.name -- the CLI adds its own prefix on top and you get dev_user_dev_user_<schema>.",
      "value": "assignment_01"
    },
    "schema_prefix": {
      "default": "",
      "description": "What the CLI prepends in this target. Consumers -- job parameters, notebook widgets -- build the effective name as assignment_01 so nothing hardcodes a name that development mode is going to rewrite.",
      "value": ""
    }
  },
  "workspace": {
    "artifact_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/artifacts",
    "file_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/files",
    "resource_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/resources",
    "root_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering",
    "state_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/state"
  }
}
