        "name": "assignment_03"
      },
      "quiz_1": {
        "catalog_name": "cscie103_catalog",
        "comment": "Quiz 1 (bike trips and ETL). Fully managed by the cscie103-data-engineering bundle. Objects created here by hand are drift.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "USE_SCHEMA",
              "SELECT"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "quiz_1"
      }
    },
    "volumes": {
      "assignment_01_audit": {
        "catalog_name": "cscie103_catalog",
        "comment": "Immutable-by-convention archive of executed job runs. Job run results are retained by Databricks for 60 days; anything needed beyond that must be materialised. Written by the archive task, never by hand.\nDOCUMENTED GAP, NOT A SOLVED PROBLEM: a SOC 2 audit vault wants S3 Object Lock in a bucket the organisation owns, with a retention policy and access logging. Free Edition has no external locations and no storage credentials, so this is a MANAGED volume on Databricks-owned storage -- durable and versioned, but not immutable and not customer-controlled. Upgrading means an external location plus a storage credential, at which point only the volume declaration changes.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "READ_VOLUME"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "audit",
        "schema_name": "${resources.schemas.assignment_01.name}",
        "volume_path": "/Volumes/cscie103_catalog/assignment_01/audit",
        "volume_type": "MANAGED"
      },
      "assignment_01_raw": {
        "catalog_name": "cscie103_catalog",
        "comment": "Landing zone for this project's source data, loaded by task.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "READ_VOLUME"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "raw",
        "schema_name": "${resources.schemas.assignment_01.name}",
        "volume_path": "/Volumes/cscie103_catalog/assignment_01/raw",
        "volume_type": "MANAGED"
      },
      "assignment_03_data": {
        "catalog_name": "cscie103_catalog",
        "comment": "Landing zone for Assignment 3's user snapshots and profile images, loaded by data:load from assignments/assignment-03/data-manifest.toml.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "READ_VOLUME"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "data",
        "schema_name": "${resources.schemas.assignment_03.name}",
        "volume_path": "/Volumes/cscie103_catalog/assignment_03/data",
        "volume_type": "MANAGED"
      },
      "quiz_1_bike_data": {
        "catalog_name": "cscie103_catalog",
        "comment": "Landing zone for Quiz 1's August 2015 bike trip data, loaded by data:load from assignments/quiz-01/data-manifest.toml.",
        "grants": [
          {
            "principal": "cscie103_readers",
            "privileges": [
              "READ_VOLUME"
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "bike_data",
        "schema_name": "${resources.schemas.quiz_1.name}",
        "volume_path": "/Volumes/cscie103_catalog/quiz_1/bike_data",
        "volume_type": "MANAGED"
      }
    }
