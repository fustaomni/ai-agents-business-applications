        ],
        "queue": {
          "enabled": true
        },
        "tasks": [
          {
            "environment_key": "default",
            "notebook_task": {
              "notebook_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/files/assignments/assignment-02/notebooks/assignment_02_etl"
