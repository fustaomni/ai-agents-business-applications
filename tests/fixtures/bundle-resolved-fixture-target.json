          "kind": "BUNDLE",
          "metadata_file_path": "/Workspace/.bundle-fixture-never-deployed/cscie103-data-engineering/state/metadata.json"
        },
        "edit_mode": "UI_LOCKED",
        "email_notifications": {
          "on_failure": [
