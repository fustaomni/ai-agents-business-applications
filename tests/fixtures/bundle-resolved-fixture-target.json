        "environments": [
          {
            "environment_key": "default",
            "spec": {
              "dependencies": [
                "plotly==6.3.0"
              ],
              "environment_version": "5"
            }
          }
        ],
        "format": "MULTI_TASK",
        "max_concurrent_runs": 1,
        "name": "assignment-02-etl",
        "parameters": [
          {
            "default": "cscie103_catalog",
            "name": "catalog"
          },
          {
