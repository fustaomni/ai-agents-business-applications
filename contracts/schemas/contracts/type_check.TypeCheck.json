{
  "ids": [
    "type-check/v1"
  ],
  "json_schema": {
    "$defs": {
      "Invocation": {
        "additionalProperties": false,
        "description": "One command, and where it runs: task:<name> or gate:<name>.",
        "properties": {
          "argv": {
            "items": {
              "type": "string"
            },
            "title": "Argv",
            "type": "array"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "argv"
        ],
        "title": "Invocation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "contract": {
        "const": "type-check/v1",
        "default": "type-check/v1",
        "title": "Contract",
        "type": "string"
      },
      "files": {
        "items": {
          "type": "string"
        },
        "title": "Files",
        "type": "array"
      },
      "invocations": {
        "items": {
          "$ref": "#/$defs/Invocation"
        },
        "title": "Invocations",
        "type": "array"
      }
    },
    "required": [
      "files",
      "invocations"
    ],
    "title": "TypeCheck",
    "type": "object"
  }
}
