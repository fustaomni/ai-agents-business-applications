            "type": "integer"
          },
          "last_line": {
            "exclusiveMinimum": 0,
            "title": "Last Line",
            "type": "integer"
          },
          "ours": {
            "items": {
              "type": "string"
            },
            "title": "Ours",
            "type": "array"
